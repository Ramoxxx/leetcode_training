class Solution:
    def isValid(self, s: str) -> bool:
        combinaisons = {
            ")":"(",
            "]":"[",
            "}":"{",
        }

        stack = []

        for e in s:
            if e in combinaisons.values():
                stack.append(e)
            else:
                if not stack:
                    return False
                if combinaisons.get(e) != stack.pop():
                    return False
        return not stack