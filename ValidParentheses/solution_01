class Solution:
    def isValid(self, s: str) -> bool:

        stack = list()
        for char in s:
            if char == "{" or char == "[" or char == "(":
                stack.append(char)
            else:
                match char:                   
                    case "}":
                        if len(stack) == 0 or stack[len(stack)-1] != "{":
                            return False
                        else:
                            stack.pop()
                    case "]":
                        if len(stack) == 0 or stack[len(stack)-1] != "[":
                            return False
                        else:
                            stack.pop()                    
                    case ")":
                        if len(stack) == 0 or stack[len(stack)-1] != "(":
                            return False
                        else:
                            stack.pop()
        print(len(stack))        
        return len(stack) == 0
